generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      String   @default("cashier") // admin | cashier
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]
  supplierPayments SupplierPayment[]
  cashSessions     CashSession[]
  labelPrints      LabelPrintHistory[]

  @@index([createdAt])
}

// ─── Categories ──────────────────────────────────────────

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

// ─── Products ─────────────────────────────────────────────

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  sku           String           @unique
  description   String?
  price         Float
  costPrice     Float            @default(0)
  categoryId    Int?
  category      Category?        @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  purchaseItems PurchaseItem[]
  imagePath     String?
  isActive      Boolean          @default(true)
  barcodeType   String           @default("auto") // auto | ean13 | qr | custom
  labelPrints   LabelPrintHistory[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
  @@index([sku])
}

model ProductVariant {
  id            Int            @id @default(autoincrement())
  productId     Int
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String
  color         String
  stock         Int            @default(0)
  barcode       String?
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@index([barcode])
}

// ─── Customers ────────────────────────────────────────────

model Customer {
  id           Int            @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  notes        String?
  createdAt    DateTime       @default(now())
  sales        Sale[]
  debtPayments DebtPayment[]

  @@index([phone])
  @@index([name])
  @@index([createdAt])
}

// ─── Debt Payments ────────────────────────────────────────

model DebtPayment {
  id          Int      @id @default(autoincrement())
  customerId  Int
  saleId      Int?
  amount      Float
  method      String   @default("cash") // cash | card | transfer
  note        String?
  allocations String?
  createdAt   DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ─── Sales ────────────────────────────────────────────────

model Sale {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  customerId Int?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  total      Float
  discount   Float      @default(0)
  tax        Float      @default(0)
  status         String     @default("completed") // completed | refunded | pending
  paymentMethod  String     @default("cash")      // cash | card | transfer
  receiptNumber  String?    @unique               // REC-YYYYMMDD-00001
  amountPaid     Float      @default(0)           // for debt tracking
  notes          String?
  createdAt      DateTime   @default(now())
  items          SaleItem[]

  @@index([createdAt])
}

model SaleItem {
  id        Int            @id @default(autoincrement())
  saleId    Int
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float
  discount  Float          @default(0)
  costPrice Float          @default(0)
  profit    Float          @default(0)
}
// --- Settings ----------------------------------------------
model Setting {
  key   String @id
  value String
}

// --- Backups -----------------------------------------------
model Backup {
  id        Int      @id @default(autoincrement())
  filename  String
  size      Int
  type      String   @default("manual") // manual | auto
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- Expenses ----------------------------------------------
model Expense {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  supplier      String?
  notes         String?
  amount        Float
  category      String
  paymentMethod String?
  receiptPath   String?
  expenseDate   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expenseDate])
  @@index([createdAt])
  @@index([updatedAt])
}

// --- Expense Categories ------------------------------------
model ExpenseCategory {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  isArchived Boolean  @default(false)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Suppliers ────────────────────────────────────────────
model Supplier {
  id           Int       @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  purchases    Purchase[]
  supplierPayments SupplierPayment[]

  @@index([createdAt])
  @@index([updatedAt])
}

// ─── Purchases ────────────────────────────────────────────
model Purchase {
  id              Int            @id @default(autoincrement())
  supplierId      Int
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  reference       String         @unique
  subtotal        Float
  discount        Float          @default(0)
  total           Float
  amountPaid      Float          @default(0)
  notes           String?
  createdAt       DateTime       @default(now())
  items           PurchaseItem[]
  supplierPayments SupplierPayment[]

  @@index([createdAt])
}

model PurchaseItem {
  id            Int            @id @default(autoincrement())
  purchaseId    Int
  purchase      Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product        @relation(fields: [productId], references: [id])
  variantId     Int
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  costPrice     Float
  total         Float
}

// ─── Activity Log ─────────────────────────────────────────
model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  entityType  String
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─── Supplier Payments ────────────────────────────────────
model SupplierPayment {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  purchaseId    Int?
  amount        Float
  paymentMethod String   @default("cash") // cash | card | transfer
  reference     String?
  notes         String?
  allocations   String?  // JSON representing allocations: [{"purchaseId": 1, "amount": 1000}]
  createdAt     DateTime @default(now())
  createdBy     Int      // links to User.id

  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  user          User     @relation(fields: [createdBy], references: [id])

  @@index([createdAt])
}

// ─── Cash Register Management ──────────────────────────────

model CashSession {
  id              Int            @id @default(autoincrement())
  userId          Int
  openedAt        DateTime       @default(now())
  closedAt        DateTime?
  openingBalance  Float
  expectedBalance Float
  actualBalance   Float?
  difference      Float?
  notes           String?
  status          String         @default("open") // open, closed
  user            User           @relation(fields: [userId], references: [id])
  movements       CashMovement[]
}

model CashMovement {
  id        Int          @id @default(autoincrement())
  sessionId Int
  type      String       // sale, refund, expense, supplier_payment, cash_in, cash_out
  amount    Float
  reason    String?
  notes     String?
  createdAt DateTime     @default(now())
  createdBy Int          // links to User.id
  session   CashSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model LabelPrintHistory {
  id          Int      @id @default(autoincrement())
  productId   Int
  userId      Int
  quantity    Int
  format      String   // 40x30, 50x30, 60x40, 80x50, a4_24, a4_30, thermal
  barcodeType String
  printedAt   DateTime @default(now())
  printerName String?

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([printedAt])
}

// ─── License System ──────────────────────────────────────────
model License {
  id           Int      @id @default(autoincrement())
  licenseKey   String   @unique
  customerName String
  businessName String
  phone        String
  email        String
  plan         String   // trial7 | trial30 | monthly | yearly | lifetime
  activatedAt  DateTime @default(now())
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  machineId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
}
