# ModaDZ — Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# WARNING: NEVER commit '.env' or real credentials/secrets to Git.

# SQLite Database connection URL for Prisma CLI & Studio
# Format: file:<relative_or_absolute_path_to_sqlite_file>
DATABASE_URL="file:./prisma/prisma/store.db"

# Application Environment (development | production)
NODE_ENV="development"
